# ==========================================
# StockMonitorAgent Frontend - Production Environment Variables
# ==========================================
# IMPORTANTE: Copiar este archivo como .env.production y llenar con valores reales
# NO commitear .env.production al repositorio (añadir a .gitignore)

# Docker Registry
DOCKER_REGISTRY=yourusername
VERSION=latest

# API Backend URL
VITE_API_URL=https://api.stockmonitor.app

# SignalR WebSocket URL
VITE_SIGNALR_HUB_URL=https://api.stockmonitor.app/hubs/alerts

# Stripe Publishable Key (live mode)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key_here

# ==========================================
# Notas:
# ==========================================
# 1. Las variables VITE_* se incluyen en el bundle en tiempo de build
# 2. Usar Stripe live keys en producción (pk_live_...)
# 3. Asegurar que las URLs coincidan con tu dominio real
# 4. NUNCA incluir secret keys del backend aquí
